# ---------- Supabase (Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Só servidor — NUNCA expor. Usada no checkout, webhook e import.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------- URL pública do site (sem barra no fim) ----------
# Usada nos redirects e no webhook da Mollie. Ex.: https://redvelvet.pt
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Mollie (Dashboard > Developers > API keys) ----------
# test_... para testar, live_... para vender a sério
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxx

# ---------- Admin ----------
# Password para /admin/import (mín. 12 caracteres)
ADMIN_SECRET=troque-por-uma-password-longa

# ---------- Dados legais (aparecem nos Termos e rodapé) ----------
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=Nome da Empresa, Lda. / Nome do Empresário
NEXT_PUBLIC_BUSINESS_NIF=123456789

# ---------- Opcional ----------
NEXT_PUBLIC_GA_ID=

# Emails das contas autorizadas a gerir stock, separados por vírgula
ADMIN_EMAILS=admin@example.com
