# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mollie
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxx

# Notificação de novos pedidos (email via Resend)
# Obtenha a chave em https://resend.com (domínio pode usar onboarding@resend.dev em teste)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Email que recebe o aviso de novo pedido (opcional; default: redvelvet.homeliving@gmail.com)
NOTIFY_EMAIL_TO=redvelvet.homeliving@gmail.com
# Remetente do email (domínio verificado no Resend; em teste: RedVelvet <onboarding@resend.dev>)
NOTIFY_EMAIL_FROM=RedVelvet <onboarding@resend.dev>
